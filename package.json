{
  "name": "hermes-ws",
  "version": "0.2.0",
  "description": "A minimal RFC 6455 WebSocket server and Vite plugin for Node.js.",
  "license": "MIT",
  "keywords": [
    "websocket",
    "rfc6455",
    "vite",
    "plugin",
    "realtime",
    "server",
    "node"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "demo": "bun examples/echo-server.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
